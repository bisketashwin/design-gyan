@'
# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
.idea/
*.iml
.vscode/
.project
.metadata
.agents

# Flutter/Dart/Pub related
# Object files
*.exe
*.dll
*.so
*.dylib

# Output of the flutter build command
build/

# Automatically generated by flutter tool
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# Plus-ins generated files
ios/.generated/
android/local.properties
android/key.properties
'@ | Out-File -FilePath .gitignore -Encoding utf-8

utils/**/*.txt
skills-lock.json
.firebase
